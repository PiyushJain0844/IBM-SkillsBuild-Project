# UrbanShield AI — Environment Configuration
# Copy this file to .env locally. Keep secrets out of source control.

# Frontend API Connection
VITE_API_BASE_URL=http://localhost:8000

# Backend API Configuration
PORT=8000
DATABASE_URL=postgresql://urbanshield_user:password@localhost:5432/urbanshield_db
JWT_SECRET=super_secret_jwt_key_change_in_production
STORAGE_BUCKET=urbanshield-uploads-s3

# Geospatial Map Tiles (Optional API Key if using custom Mapbox/Carto tiles)
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Machine Learning Service Settings
MODEL_PATH=./ml/models/urbanshield_cv_resnet50.onnx
CONFIDENCE_THRESHOLD=0.70
